# MotionWatch service settings. Cameras, schedules and Telegram are managed in the web interface.

# Address of the web interface. Use 127.0.0.1:8080 to allow access from this machine only
# (e.g. behind a reverse proxy that adds HTTPS).
MOTIONWATCH_WEB_LISTEN=0.0.0.0:8080

# Optional: values here can be referenced from the config as ${NAME}, e.g. a camera password
# you'd rather not store in the config file.
# CAM_PASS=
