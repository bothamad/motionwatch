[Unit]
Description=MotionWatch CCTV motion alerts
Documentation=https://github.com/bothamad/motionwatch
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=motionwatch
Group=motionwatch
Environment=MOTIONWATCH_DATA=/var/lib/motionwatch
EnvironmentFile=-/etc/motionwatch/motionwatch.env
ExecStart=/usr/bin/motionwatch run
Restart=always
RestartSec=10
StateDirectory=motionwatch
StateDirectoryMode=0750
UMask=0077
SupplementaryGroups=video

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=/var/lib/motionwatch

[Install]
WantedBy=multi-user.target
